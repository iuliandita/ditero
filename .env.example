# Copy to .env (gitignored). Dev-only values, no real secrets committed.
DATABASE_URL=postgres://postgres:pass@localhost:5432/ditero
DATABASE_MIGRATION_URL=
DITERO_RUNTIME_DB_PASSWORD=
DITERO_MIGRATION_DB_PASSWORD=
BETTER_AUTH_SECRET=dev-change-me
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins auth routes accept, on top of BETTER_AUTH_URL;
# without them every auth request from another address is rejected 403. Outside
# production this is also the CORS allowlist (production disables CORS).
TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET_FILE=
DITERO_ENCRYPTION_KEY=
DITERO_ENCRYPTION_KEY_NEXT=
DITERO_TRUSTED_PROXIES=
API_PORT=3000
# The address browsers dial zero-cache on. Served to the web client at runtime
# from /api/config and used for the CSP, so one built image serves any hostname.
PUBLIC_ZERO_URL=http://localhost:4848
# Schema zero-cache keeps its per-client sync bookkeeping in. Must match the
# app id zero-cache runs with, or the push endpoint cannot record
# lastMutationID and every mutation fails. See docs/runbooks/database-roles.md.
DITERO_ZERO_SHARD_SCHEMA=zero_0
# open | bootstrap | closed (production default: bootstrap)
DITERO_REGISTRATION_MODE=open

# --- Encrypted attachments ---------------------------------------------------
# filesystem (default) stores ciphertext under this host path. Production
# Compose overrides it to a named volume at /data/attachments.
DITERO_ATTACHMENT_STORAGE_DRIVER=filesystem
DITERO_ATTACHMENT_FS_PATH=./data/attachments
# Per-workspace reserved + committed ciphertext bytes. Default: 10 GiB.
DITERO_ATTACHMENT_QUOTA_BYTES=10737418240
# Deleting blobs remain restorable for this long. Keep it longer than the
# interval between complete database+blob backups. Default: 30 days.
DITERO_ATTACHMENT_RETENTION_MS=2592000000
# Rows processed per attachment-leader sweep. Maximum: 1000.
DITERO_ATTACHMENT_SWEEP_BATCH_SIZE=100
# Independent leader-elected sweep cadence. Default: one hour.
DITERO_ATTACHMENT_SWEEP_MS=3600000
# S3-compatible mode: set the driver to s3, clear the filesystem path, and set
# bucket + region. Endpoint is optional for AWS and required by most compatible
# providers. Credentials are optional as a pair so workload credentials work.
DITERO_ATTACHMENT_S3_BUCKET=
DITERO_ATTACHMENT_S3_REGION=
DITERO_ATTACHMENT_S3_ENDPOINT=
DITERO_ATTACHMENT_S3_ACCESS_KEY_ID=
DITERO_ATTACHMENT_S3_ACCESS_KEY_ID_FILE=
DITERO_ATTACHMENT_S3_SECRET_ACCESS_KEY=
DITERO_ATTACHMENT_S3_SECRET_ACCESS_KEY_FILE=

# --- Notifications (see docs/notifications.md) ---------------------------------
# Public origin ack links point at. Falls back to BETTER_AUTH_URL; with neither
# set, notifications carry no acknowledge button.
DITERO_PUBLIC_URL=
# Comma-separated CIDRs a user-supplied channel URL may resolve into, on top of
# public addresses. Empty = public addresses only. A /0 entry is rejected at
# boot. Loopback, link-local (incl. cloud metadata), CGNAT, multicast, broadcast
# and IPv6 transition ranges can never be re-enabled here.
DITERO_NOTIFY_ALLOWED_PRIVATE_CIDRS=
# Shared secret Telegram echoes on every webhook delivery (setWebhook's
# secret_token: 1-256 chars, A-Z a-z 0-9 _ -). Deployment-level, not per user.
# Unset means the listener authenticates nothing and rejects every delivery with
# a uniform 400 -- so an operator who runs setWebhook without setting this here
# too sees no acks at all.
DITERO_TELEGRAM_WEBHOOK_SECRET=
# How Telegram updates reach this deployment: `poll` (default) long-polls
# getUpdates, which is outbound only and needs no public URL, no certificate and
# no port forward; `webhook` registers the listener above with every configured
# bot. The two are mutually exclusive AT THE PROVIDER, so the app clears the
# other side on boot and logs what it set or cleared per bot.
DITERO_TELEGRAM_MODE=poll
# How long each getUpdates call is held open, in seconds (max 60).
DITERO_TELEGRAM_POLL_TIMEOUT_SEC=25
# Bot tokens are per user, so a deployment where users bring their own bots has
# several. This caps how many are polled at once; the rest receive no acks and
# the truncation is logged.
DITERO_TELEGRAM_MAX_BOTS=10

# Email (operator-wide, never per user: the per-user setting is only the
# destination address). Unset DITERO_SMTP_HOST disables the email channel --
# saving one is refused with an explanatory error -- and the app still boots.
DITERO_SMTP_HOST=
# Default 587 (submission). 465 switches to implicit TLS on its own.
DITERO_SMTP_PORT=
# true = implicit TLS from the first byte (SMTPS). Defaults to true on port 465,
# false elsewhere, where the connection is instead upgraded with STARTTLS and
# the send FAILS if the server does not offer it.
DITERO_SMTP_SECURE=
# Drops that STARTTLS requirement, allowing cleartext SMTP -- including the
# credentials below. For a local relay on the same host or LAN and nothing else.
DITERO_SMTP_ALLOW_INSECURE=
# Both or neither. Encrypted nowhere: keep them in a secret file/manager, not in
# a shell history.
DITERO_SMTP_USER=
DITERO_SMTP_PASSWORD=
# Envelope sender. "Ditero <ditero@example.com>" is accepted. Required whenever
# DITERO_SMTP_HOST is set.
DITERO_SMTP_FROM=

# Scheduler (leader-elected: one replica scans per tick).
# Scan interval.
DITERO_SCHEDULER_TICK_MS=30000
# How far back each scan looks. Occurrences older than this are never
# materialized -- an outage longer than the grace window drops its reminders.
DITERO_SCHEDULER_GRACE_MS=3600000
# Lateness past which a reminder is flagged fired_late (operator signal only).
DITERO_SCHEDULER_LATE_THRESHOLD_MS=60000
# Overdue-task sweep interval. Idempotent per recipient local day, so this is
# deliberately hours, not ticks.
DITERO_OVERDUE_SWEEP_MS=3600000

# Outbox worker (runs on every replica).
# Drain interval.
DITERO_WORKER_TICK_MS=1000
# How long a claim is trusted before another replica may reclaim the row.
DITERO_WORKER_LEASE_MS=60000
# Per-send deadline enforced by the worker and again by each adapter.
DITERO_NOTIFY_DEADLINE_MS=15000
# Rows claimed per tick, and how many of them are in flight at once.
DITERO_WORKER_BATCH_SIZE=20
DITERO_WORKER_CONCURRENCY=10
# How long terminal outbox rows and their attempt history are kept.
DITERO_OUTBOX_RETENTION_MS=2592000000
# Prune every Nth worker tick, this many rows per pass.
DITERO_PRUNE_CADENCE_TICKS=60
DITERO_PRUNE_BATCH_SIZE=1000
# Queued+in-flight notifications one user may hold. Past this, further
# notifications for that user are REFUSED, not queued.
DITERO_MAX_QUEUED_PER_USER=500
# Fence identity written to claimed_by. Must be unique per process; a random
# value is generated per boot when unset. Never share one value across replicas.
DITERO_REPLICA_ID=

# Ordering constraints, all validated at boot (the process refuses to start):
#   DITERO_SCHEDULER_LATE_THRESHOLD_MS >= 2 * DITERO_SCHEDULER_TICK_MS
#     -- a shorter threshold reports ordinary scheduling delay as lateness.
#   DITERO_SCHEDULER_GRACE_MS >= DITERO_SCHEDULER_TICK_MS
#     -- a grace window shorter than the tick drops reminders between ticks.
#   ceil(BATCH_SIZE / CONCURRENCY) * (NOTIFY_DEADLINE_MS + 5000) < LEASE_MS
#     -- the 5000ms is the per-wave allowance for the completion write. If a
#        full batch can outlive the lease, a hanging provider has its rows
#        reclaimed mid-send and delivers the same notification once per lease
#        interval, forever, from one row. The fence cannot prevent that: it
#        protects row state, not the network.
