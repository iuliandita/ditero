{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Ditero",
	"version": "0.0.1",
	"identifier": "io.ditero.desktop",
	"build": {
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"capabilities": ["main"],
			"csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"shortDescription": "Ditero desktop development build",
		"category": "Productivity",
		"macOS": {
			"signingIdentity": "-"
		},
		"linux": {
			"deb": {
				"depends": ["libssl3 | libssl3t64", "libdbus-1-3"],
				"files": {
					"/usr/share/metainfo/io.ditero.desktop.metainfo.xml": "../linux/io.ditero.desktop.metainfo.xml",
					"/usr/share/applications/io.ditero.desktop.desktop": "../linux/io.ditero.desktop.desktop",
					"/usr/share/icons/hicolor/128x128/apps/io.ditero.desktop.png": "icons/128x128.png",
					"/usr/share/doc/ditero-desktop/LICENSE": "../../../LICENSE"
				},
				"desktopTemplate": "../linux/hidden.desktop"
			},
			"rpm": {
				"depends": [
					"glibc",
					"libc.so.6(GLIBC_2.39)(64bit)",
					"webkit2gtk4.1",
					"gtk3",
					"openssl-libs",
					"dbus-libs"
				],
				"files": {
					"/usr/share/metainfo/io.ditero.desktop.metainfo.xml": "../linux/io.ditero.desktop.metainfo.xml",
					"/usr/share/applications/io.ditero.desktop.desktop": "../linux/io.ditero.desktop.desktop",
					"/usr/share/icons/hicolor/128x128/apps/io.ditero.desktop.png": "icons/128x128.png",
					"/usr/share/doc/ditero-desktop/LICENSE": "../../../LICENSE"
				},
				"desktopTemplate": "../linux/hidden.desktop"
			},
			"appimage": {
				"files": {
					"usr/share/metainfo/io.ditero.desktop.metainfo.xml": "../linux/io.ditero.desktop.metainfo.xml",
					"usr/share/applications/io.ditero.desktop.desktop": "../linux/io.ditero.desktop.desktop",
					"usr/share/icons/hicolor/128x128/apps/io.ditero.desktop.png": "icons/128x128.png",
					"usr/share/doc/ditero-desktop/LICENSE": "../../../LICENSE"
				}
			}
		},
		"publisher": "iuliandita",
		"homepage": "https://ditero.app",
		"license": "MIT",
		"licenseFile": "../../../LICENSE",
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	}
}
