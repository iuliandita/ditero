{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"@/*": ["./src/web/*"]
		},
		"types": ["bun", "node"]
	},
	"include": ["src", "tests", "drizzle.config.ts", "vite.config.ts"]
}
