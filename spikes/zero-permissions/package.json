{
  "name": "ditero-spike-zero-permissions",
  "private": true,
  "type": "module",
  "description": "Spike A: prove Zero multi-workspace row-permissions (a member cannot sync another member's private list).",
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/seed.ts",
    "zero:gen": "drizzle-zero generate -o src/zero/schema.gen.ts",
    "dev:api": "bun run --hot src/server.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test:matrix": "playwright test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@rocicorp/zero": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "drizzle-zero": "^0.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
