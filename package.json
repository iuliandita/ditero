{
	"name": "ditero",
	"type": "module",
	"private": true,
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/db/migrate.ts",
		"security:rotate-auth-secrets": "bun run src/security/rotate-auth-secrets.ts",
		"security:encrypt-channel-configs": "bun run src/security/encrypt-channel-configs.ts",
		"zero:gen": "drizzle-zero generate -o src/zero/schema.gen.ts",
		"lint": "biome check",
		"dev:server": "bun run --hot src/server/index.ts",
		"dev:web": "vite",
		"zero:cache": "docker compose up zero-cache",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy cookie localStorage preferredLanguage baseLocale",
		"i18n:validate": "bun run scripts/i18n-validate.ts",
		"typecheck": "bun run i18n:compile && tsc --noEmit",
		"test": "vitest run src/ scripts/",
		"test:integration": "bun run tests/integration/run.ts",
		"test:e2e": "bun run tests/e2e/run.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "^2.5.3",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/bun": "^1.3.14",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-zero": "^0.19.0",
		"shadcn": "^4.13.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.4",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.6.23",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@elysiajs/cors": "^1.4.2",
		"@fontsource-variable/geist": "^5.2.9",
		"@inlang/paraglide-js": "^2.22.0",
		"@inlang/plugin-message-format": "^4.4.0",
		"@rocicorp/zero": "^1.7.0",
		"@sinclair/typebox": "^0.34.49",
		"better-auth": "^1.6.23",
		"chrono-node": "^2.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"croner": "^10.0.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.29",
		"exact-mirror": "^0.2.7",
		"file-type": "^22.0.1",
		"fractional-indexing": "^4.0.0",
		"ipaddr.js": "^2.2.0",
		"jose": "^6.2.3",
		"lucide-react": "^1.24.0",
		"motion": "^12.42.2",
		"nodemailer": "^9.0.3",
		"openapi-types": "^12.1.3",
		"pg": "^8.22.0",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"rrule": "^2.8.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"overrides": {
		"uuid": "^11.1.1",
		"fast-uri": "^3.1.4",
		"brace-expansion": "^2.1.2",
		"@opentelemetry/propagator-jaeger": "^2.9.0",
		"find-my-way": "^9.7.0"
	}
}
