{
	"name": "ditero",
	"type": "module",
	"private": true,
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"zero:gen": "drizzle-zero generate -o src/zero/schema.gen.ts",
		"lint": "biome check",
		"dev:server": "bun run --hot src/server/index.ts",
		"dev:web": "vite",
		"zero:cache": "docker compose up zero-cache",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --dir src",
		"test:integration": "bun run tests/integration/run.ts",
		"test:e2e": "bun run tests/e2e/run.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/bun": "^1.3.14",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-zero": "^0.19.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@rocicorp/zero": "^1.7.0",
		"better-auth": "^1.6.23",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.29",
		"jose": "^6.2.3",
		"pg": "^8.22.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"zod": "^4.4.3"
	}
}
